          },
          {
            "type": "extractFile",
            "file": "/3ds/3ds-ua.zip",
            "input": "^luma/",
            "output": "/luma/",
            "message": "Розпакування..."
          },
          {
            "type": "deleteFile",
            "file": "/3ds/3ds-ua.zip"
          },
          {
            "type": "skip",
            "count": 3
          },
          {
            "type": "downloadRelease",
            "repo": "BolgarMaxym97/3ds-ua",
            "file": "3ds-ua-from-en-.*-old3ds\\.zip",
            "output": "/3ds/3ds-ua.zip",
            "message": "Завантаження архіву (~23 МБ)...",
            "includePrereleases": false
          },
          {
            "type": "extractFile",
            "file": "/3ds/3ds-ua.zip",
            "input": "^luma/",
            "output": "/luma/",
            "message": "Розпакування..."
          },
          {
            "type": "deleteFile",
            "file": "/3ds/3ds-ua.zip"
          },
          {
            "type": "promptMessage",
            "message": "Готово.\n\n1. Вимкніть консоль, увімкніть із затиснутим SELECT,\n   увімкніть Enable game patching, натисніть START.\n2. Налаштування системи -> Інші налаштування ->\n   Мова -> Українська."
          }
        ]
      },
