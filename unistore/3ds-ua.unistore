{
  "storeInfo": {
    "title": "3DS UA",
    "author": "BolgarMaxym97",
    "description": "Українська мова для системного інтерфейсу Nintendo 3DS. Стає на місце російського або англійського мовного слота; який саме - питає під час установки.",
    "url": "https://raw.githubusercontent.com/BolgarMaxym97/3ds-ua/main/unistore/3ds-ua.unistore",
    "file": "3ds-ua.unistore",
    "version": 3,
    "revision": 10800,
    "infoURL": "https://github.com/BolgarMaxym97/3ds-ua",
    "sheet": "3ds-ua.t3x",
    "sheetURL": "https://raw.githubusercontent.com/BolgarMaxym97/3ds-ua/main/unistore/3ds-ua.t3x"
  },
  "storeContent": [
    {
      "1. Встановити / оновити": {
        "size": "~23 МБ",
        "script": [
          {
            "type": "promptMessage",
            "message": "У вас New 3DS, New 3DS XL або New 2DS XL?\n\nМодель написана спереду під нижнім екраном.",
            "name": "new3ds",
            "count": 9
          },
          {
            "type": "promptMessage",
            "message": "Замінити РОСІЙСЬКУ мову?\n\nНі = замінити англійську.",
            "name": "slot",
            "count": 4
          },
          {
            "type": "downloadRelease",
            "repo": "BolgarMaxym97/3ds-ua",
            "file": "3ds-ua-from-ru-.*-new3ds\\.zip",
            "output": "/3ds/3ds-ua.zip",
            "message": "Завантаження архіву (~23 МБ)...",
            "includePrereleases": false
          },
          {
            "type": "extractFile",
            "file": "/3ds/3ds-ua.zip",
            "input": "^luma/",
            "output": "/luma/",
            "message": "Розпакування..."
          },
          {
            "type": "deleteFile",
            "file": "/3ds/3ds-ua.zip"
          },
          {
            "type": "skip",
            "count": 12
          },
          {
