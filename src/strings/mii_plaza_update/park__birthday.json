  "dlg_bd_op_00_u": {
    "en": "Thank you for purchasing\r\nStreetPass Mii Plaza Premium!",
    "ua": "Дякуємо за придбання\nПреміум-площі StreetPass Mii!"
  },
  "dlg_bd_op_01_u": {
    "en": "Welcome to\r\nStreetPass Birthdays!",
    "ua": "Вітаємо в Календарі\nStreetPass!"
  },
  "dlg_bd_op_02_u": {
    "en": "This is a special calendar\r\nbased on your StreetPass\r\nMii Plaza progress.",
    "ua": "Це особливий календар,\nякий залежить від ваших\nуспіхів на Площі StreetPass Mii."
  },
  "dlg_bd_op_03_u": {
    "en": "It gets coloured in based on\r\nthe birthday settings of the\r\nMii characters you meet.",
    "ua": "Його розфарбовують дні\nнародження Mii, яких\nви зустрічаєте."
  },
  "dlg_bd_op_04_u": {
    "en": "Try to meet people with as many\r\ndifferent birthdays as you can.",
    "ua": "Шукайте людей з різними\nднями народження."
  },
  "dlg_bd_op_05_u": {
    "en": "That's the way to\r\ncolour your calendar!",
    "ua": "Так і розфарбуєте\nсвій календар!"
  },
